{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "purpose",
    "input_sha256",
    "policy_sha256",
    "model",
    "output"
  ],
  "properties": {
    "purpose": {
      "anyOf": [
        {
          "const": "response_kind_check",
          "type": "string"
        },
        {
          "const": "identity_strip",
          "type": "string"
        },
        {
          "const": "expert_guess",
          "type": "string"
        }
      ]
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "reason",
            "addresses_judge"
          ],
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "const": "refusal",
                  "type": "string"
                },
                {
                  "const": "answer",
                  "type": "string"
                },
                {
                  "const": "other",
                  "type": "string"
                }
              ]
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "addresses_judge": {
              "type": "boolean"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "expert_id",
            "confidence",
            "reason"
          ],
          "properties": {
            "expert_id": {
              "anyOf": [
                {
                  "const": "clinician",
                  "type": "string"
                },
                {
                  "const": "biohacker",
                  "type": "string"
                },
                {
                  "const": "nutritionist",
                  "type": "string"
                }
              ]
            },
            "confidence": {
              "minimum": 0,
              "maximum": 1,
              "type": "number"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
