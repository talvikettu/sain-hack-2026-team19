{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "prompt",
    "dictionary",
    "examples"
  ],
  "properties": {
    "version": {
      "minLength": 1,
      "type": "string"
    },
    "prompt": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "prompt_id",
        "version",
        "purpose",
        "text",
        "model_version",
        "temperature"
      ],
      "properties": {
        "prompt_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "type": "string"
        },
        "temperature": {
          "const": 0,
          "type": "number"
        }
      }
    },
    "dictionary": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "expression"
        ],
        "properties": {
          "category": {
            "minLength": 1,
            "type": "string"
          },
          "expression": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "minItems": 50,
      "maxItems": 50,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "allowed",
          "category"
        ],
        "properties": {
          "text": {
            "minLength": 1,
            "type": "string"
          },
          "allowed": {
            "type": "boolean"
          },
          "category": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  }
}
